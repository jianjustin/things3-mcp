#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run linting first to catch code quality issues
npm run lint

# Run unit tests
npm run test:unit

# Integration tests are NOT run here: they create, modify and delete data in
# the real Things3 database of whoever is committing. Run them manually against
# a dedicated/test Things3 setup with THINGS3_INTEGRATION=1 npm run test:integration
